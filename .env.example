# Copy to .env for local development. Never commit real values.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://nova:nova@localhost:5432/nova_dev
API_PORT=3000
# Which deployment this is: dev | staging | prod.
NOVA_ENV=dev
# Outside prod, Nova may only target these addresses (comma-separated). Put your own test accounts here.
NOVA_RECIPIENT_ALLOWLIST=you@example.com
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this comes from the host's secret manager, never from a file.
NOVA_MASTER_KEY=
