# Copy to .env for local development. Never commit real values.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://nova:nova@localhost:5432/nova_dev
API_PORT=3000
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this comes from the host's secret manager, never from a file.
NOVA_MASTER_KEY=
